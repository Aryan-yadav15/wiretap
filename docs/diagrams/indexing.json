  "cards": [
    {
      "dot": "emerald",
      "title": "Only what changed",
      "items": [
        "A watcher compares file mtimes every second",
        "Changed files are re-parsed; the rest come from extract.json",
        "A cold index of 638 files took 1.7 s"
      ]
    },
    {
      "dot": "cyan",
      "title": "Linking",
      "items": [
        "Imports and aliases resolve calls across files",
        "API calls match backend routes by method and path",
        "Supabase and SQLAlchemy calls become table reads and writes"
      ]
    },
    {
      "dot": "orange",
      "title": "No running app",
      "items": [
        "Code is parsed, never executed",
        "TypeScript is parsed without type checking",
        "Calls through strings or DI can be missed and are counted"
      ]
    }
  ]
