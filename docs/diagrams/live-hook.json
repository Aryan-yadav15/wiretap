  "cards": [
    {
      "dot": "emerald",
      "title": "Never blocks Claude",
      "items": [
        "The server answers 200 before doing any work",
        "curl gives up after 1 s and the hook always exits 0",
        "A stopped server costs Claude nothing"
      ]
    },
    {
      "dot": "cyan",
      "title": "In order",
      "items": [
        "One worker thread drains the hook queue",
        "Only edits re-parse a file; reads and searches don't",
        "Every open tab gets the same snapshot over SSE"
      ]
    },
    {
      "dot": "orange",
      "title": "The only LLM call",
      "items": [
        "Summarize runs claude -p on the git diff",
        "Only when the button is pressed",
        "WIRETAP_SKIP keeps that run off the map"
      ]
    }
  ]
